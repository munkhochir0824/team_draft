# Password required to access /admin (player management).
ADMIN_PASSWORD=change-me

# Vercel KV (Redis) — get these from your Vercel project's Storage tab
# after creating/connecting a KV (Upstash Redis) store, or via `vercel env pull`.
# If left unset, the app falls back to an in-memory store for local dev only
# (data resets on every server restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=
